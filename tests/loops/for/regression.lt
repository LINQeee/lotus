// Assignments change the value used by the following automatic step.
for j in 0..5 {
    print(j)
    if j == 0 j = 2
}
for j in 5..0 {
    print(j)
    if j == 5 j -= 2
}
for j in 0..4 {
    print(j)
    if j == 0 {
        j = 2
        continue
    }
}

fn mutateCounter() {
    for j in 0..5 {
        print(j)
        while true {
            if j == 1 j = 3
            continue @2
        }
    }
}

mutateCounter()
for j in 0..2147483647 {
    print(j)
    if j == 0 j = 2147483646
}
for j in 0L..-9223372036854775808L {
    print(j)
    if j == 0L j = -9223372036854775807L
}
// Assigning beyond the end finishes on the next step, without wrapping.
for j in 0..2 j = 2147483647
for j in 0..-2 j = -2147483648
