fn sum(): int {
    int result = 0
    for j in 0..!5 {
        if j == 2 continue
        if j == 4 break
        result += j
    }
    return result
}

print(sum())
for outer in 0..!3 {
    while true {
        print(outer)
        continue @2
    }
}
int n = 0
while n < 3 {
    n += 1
    for inner in 0..!3 {
        if inner == 1 continue @2
        print(n)
    }
}
for outer in 0..!3 {
    for inner in 0..!3 {
        print(outer + inner)
        break @2
    }
}

