print(("a" + "b") == ("a" + "b"))
print(("a" + "b") != ("a" + "c"))

fn repeatedInput() {
    int j = 0
    while j < 100000 {
        string empty = input()
        input()
        j += 1
    }
}

repeatedInput()

fn forMemory(): string {
    for outer in 0..!100000 {
        string temporary = "a" + "b"
        for inner in 0..2 {
            string nested = temporary + "c"
            continue @2
        }
    }
    for outer in 0..!3 {
        string temporary = "a" + "b"
        while true {
            string nested = temporary + "c"
            break @2
        }
    }
    for j in 0..1 {
        string result = "do" + "ne"
        return result
    }
    return "unreachable"
}

print(forMemory())
