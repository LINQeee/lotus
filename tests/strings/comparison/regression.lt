string joined = "hel" + "lo"
print(joined == "hello")
print(joined != "hello")
print(joined == joined)
print("Привет" == "При" + "вет")

fn equalStrings(left: string, right: string): bool {
    return left == right
}

print(equalStrings("a" + "b", "ab"))
int calls = 0

fn nextString(): string {
    calls += 1
    return "once"
}

print(nextString() == nextString())
print(calls)
