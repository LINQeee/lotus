{
  "name": "lotus",
  "displayName": "Lotus",
  "scopeName": "source.lotus",
  "fileTypes": [
    "lt"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.lotus",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.lotus",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.lotus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lotus",
          "match": "\\\\[nt\\\\\"]"
        }
      ]
    },
    {
      "name": "string.quoted.single.lotus",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.lotus",
          "match": "\\\\[nt\\\\']"
        }
      ]
    },
    {
      "name": "storage.type.lotus",
      "match": "\\b(int|long|float|double|bool|string)\\b"
    },
    {
      "name": "keyword.control.lotus",
      "match": "\\b(fn|if|else|while|for|in|step|return|break|continue|next)\\b"
    },
    {
      "name": "constant.language.lotus",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.numeric.lotus",
      "match": "\\b[0-9]+(?:\\.(?!\\.)[0-9]*)?[fFdDlL]?\\b"
    },
    {
      "name": "entity.name.function.lotus",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.lotus",
      "match": "\\.\\.|\\*\\*|[+*/%=!<>&|@-]"
    }
  ],
  "repository": {}
}
