{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lotus",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "cli",
              "status"
            ]
          }
        ]
      },
      {
        "tab": "Language",
        "groups": [
          {
            "group": "Language guide",
            "pages": [
              "language/types",
              "language/variables",
              "language/expressions",
              "language/control-flow",
              "language/functions",
              "language/strings",
              "language/arrays"
            ]
          },
          {
            "group": "Standard library",
            "pages": [
              "runtime"
            ]
          }
        ]
      },
      {
        "tab": "Contribute",
        "groups": [
          {
            "group": "Development",
            "pages": [
              "development/workflow",
              "development/tests",
              "development/compiler"
            ]
          },
          {
            "group": "Extend and maintain",
            "pages": [
              "development/native",
              "development/documentation"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/LINQeee/lotus"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/LINQeee/lotus"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "IBM Plex Mono"
  },
  "background": {
    "color": {
      "light": "#FAF9F6",
      "dark": "#121116"
    }
  }
}
